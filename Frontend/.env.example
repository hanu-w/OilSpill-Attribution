# OceanWatch Frontend Environment Variables
# Copy this file to .env and fill in values as needed

# API Configuration
# Base URL for the FastAPI backend (leave empty for mock mode)
VITE_API_BASE_URL=

# Data Mode
# Set to 'true' to use mock data, 'false' for real API calls
VITE_USE_MOCK_DATA=true

# Map Configuration
# URL for MapLibre style (can be a local style or remote service)
VITE_MAP_STYLE_URL=
